PORT=3000
NODE_ORACLEDB_USER=
NODE_ORACLEDB_PASSWORD=
NODE_ORACLEDB_CONNECTIONSTRING=host:1521/service_name
# Separar múltiples orígenes con coma. En desarrollo, si se omite, se permiten localhost:5173/5174.
CORS_ORIGINS=http://localhost:5173

# --- Seguridad / login ---
# OBLIGATORIO (mín. 32 caracteres, aleatorio). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Opcionales (valores por defecto entre paréntesis)
# ACCESS_TOKEN_MINUTES=15
# SESSION_MAX_HOURS=10
# SESSION_IDLE_MINUTES=30
# MAX_FAILED_ATTEMPTS=5
# LOCK_MINUTES=15
# NODE_ENV=production   # activa cookies Secure (requiere HTTPS)

# --- Recuperación de contraseña por correo ---
# URL donde corre el cliente (se usa en el enlace del correo)
APP_URL=http://localhost:5173
# Servidor de correo. Si SMTP_HOST queda vacío, en desarrollo el enlace se imprime en la consola del servidor.
# SMTP_HOST=smtp.tuempresa.com
# SMTP_PORT=587
# SMTP_SECURE=false      # true para el puerto 465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ERP System <no-reply@tuempresa.com>"
# RECOVERY_TOKEN_MINUTES=30
