{
  "name": "erp-universitario",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo oficial para el ERP Universitario",
  "scripts": {
    "predev": "pnpm --filter @erp/contracts build",
    "dev": "pnpm --filter \"@erp/*\" --parallel dev",
    "build": "pnpm --filter \"@erp/*\" build",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:audit": "playwright test e2e/auditoria-rutas.spec.ts",
    "test:audit:strict": "cross-env AUDIT_STRICT=1 playwright test e2e/auditoria-rutas.spec.ts",
    "typecheck": "pnpm --filter @erp/contracts build && pnpm --filter @erp/server exec tsc --noEmit && pnpm --filter @erp/client exec tsc --noEmit",
    "audit:deps": "pnpm audit --prod",
    "audit:static": "pnpm typecheck && pnpm audit:deps",
    "audit:full": "pnpm audit:static && pnpm test:audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "3.2.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.5.4",
    "vitest": "3.2.4"
  }
}
