{
  "name": "erp-universitario",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo oficial para el ERP Universitario",
  "scripts": {
    "predev": "pnpm --filter @erp/contracts build",
    "dev": "pnpm --filter \"@erp/*\" --parallel dev",
    "build": "pnpm --filter \"@erp/*\" build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^5.5.4"
  }
}
