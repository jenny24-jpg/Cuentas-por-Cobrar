# Variables del cliente (Vite). Todo lo que empiece con VITE_ queda visible en el
# navegador: aquí NUNCA van contraseñas, JWT_SECRET ni datos de Oracle.
# Esos valores van solo en server/.env.

# URL de la API (por defecto http://localhost:3000/api)
# VITE_API_URL=http://localhost:3000/api
# Tiempo máximo de espera de cada petición, en milisegundos (por defecto 15000)
# VITE_API_TIMEOUT_MS=15000
# Proveedor de mapas para rutas (opcional)
# VITE_MAPA_TILES_URL=
# VITE_MAPA_TILES_ATRIBUCION=
