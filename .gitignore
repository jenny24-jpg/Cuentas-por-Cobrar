# ##############################################################################
# Git Ignore Configuration - Monorepo ERP Universitario
# ##############################################################################

# 1. Dependencias (node_modules)
# Bloquea node_modules en la raíz y en todos los paquetes del monorepo
node_modules/

# 2. Caché y archivos temporales de pnpm
.pnpm-store/
pnpm-debug.log*

# 3. Compilación, transpilación y distribución
dist/
build/
out/
*.tsbuildinfo

# 4. Configuración de entorno y secretos locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# 5. Editores de código e IDEs
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 6. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# 7. Registros y logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log
